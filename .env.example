# ── Firebase (frontend) ──────────────────────────────────────────────────────
# Find these in Firebase Console → Project Settings → Your apps → Web app → SDK snippet
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Admin (backend) ─────────────────────────────────────────────────
# No credentials needed — uses Application Default Credentials (ADC).
# One-time setup:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <firebase-project-id>
