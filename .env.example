# Firebase (frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATOR=

# Firebase Admin (backend)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Auth
VITE_AUTH_ENABLED=true

# device auth
DEVICE_SECRET=

# ── Backend port ──────────────────────────────────────────────────────────────
# Defaults to 3000 if unset. Change if port 3000 is taken on your machine.
# The Vite dev proxy reads this automatically — no other config needed.
PORT=
TARGET=