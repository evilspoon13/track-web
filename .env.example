# ── Firebase (frontend) ──────────────────────────────────────────────────────
# Find these in Firebase Console → Project Settings → Your apps → Web app → SDK snippet
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Admin (backend) ─────────────────────────────────────────────────
# Local dev: leave these empty and use ADC instead:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <firebase-project-id>
#
# Production: fill these in from Firebase Console → Project Settings →
#   Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=