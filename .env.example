# ── Firebase (frontend) ──────────────────────────────────────────────────────
# Find these in Firebase Console → Project Settings → Your apps → Web app → SDK snippet
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase Admin (backend) ─────────────────────────────────────────────────
# Always required (used even with emulator for project context)
FIREBASE_PROJECT_ID=
# Production only — fill in from Firebase Console → Project Settings →
#   Service Accounts → Generate new private key
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Emulator (local dev) ─────────────────────────────────────────────────────
# These are loaded automatically by dotenv — no shell prefix needed.
# The frontend auto-connects to the emulator in DEV mode (VITE_USE_EMULATOR not needed).
# For docker compose targeting the emulator, change hosts to host.docker.internal.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
VITE_USE_EMULATOR=false

# ── Backend port ──────────────────────────────────────────────────────────────
# Defaults to 3000 if unset. Change if port 3000 is taken on your machine.
# The Vite dev proxy reads this automatically — no other config needed.
PORT=